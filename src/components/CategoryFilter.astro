---
/**
 * Reusable category filter component with checkboxes.
 * Renders a list of categories with checkboxes to filter games.
 * Uses URL query parameters to persist filter state.
 */
interface Props {
  /** Array of all available categories with id and name */
  categories: Array<{ id: number; name: string }>;
  /** Array of currently selected category IDs */
  selectedCategoryIds: number[];
}

const { categories, selectedCategoryIds } = Astro.props;
---

<fieldset class="mb-8">
  <legend class="block text-lg font-semibold text-slate-100 mb-4">Categories</legend>
  <div class="space-y-3" role="group" aria-labelledby="category-legend">
    {categories.map((category) => {
      const checkboxId = `category-${category.id}`;
      return (
        <div class="flex items-center">
          <input
            type="checkbox"
            id={checkboxId}
            data-filter-type="category"
            value={category.id}
            checked={selectedCategoryIds.includes(category.id)}
            data-testid={`category-filter-${category.id}`}
            class="w-4 h-4 rounded border-slate-600 bg-slate-700 text-blue-600 cursor-pointer focus:ring-2 focus:ring-blue-500 focus:ring-offset-slate-800"
            aria-label={`Filter by ${category.name} category`}
          />
          <label
            for={checkboxId}
            class="ml-3 text-slate-300 cursor-pointer hover:text-slate-100 transition-colors duration-150"
          >
            {category.name}
          </label>
        </div>
      );
    })}
  </div>
</fieldset>
